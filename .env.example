# Copy to `.env` and fill in. `.env` is git-ignored. Never commit real credentials.
#
# This file documents the SHAPE of the credential set. Only these keys are read
# from the environment; everything else (model, base_url, batch size, thresholds)
# lives in config.yaml so there is one source of truth and no secrets in Git.

# ---------------------------------------------------------------------------
# Phase 2 — ranking. READ by src/synthetic_data/llm.py.
# The key is the only value here that is a secret. Get one at
# https://openrouter.ai/keys — the free tier needs no payment method.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Phase 5 — email. READ by src/synthetic_data/emailer.py.
# Use a dedicated sender account with an app password, not a personal one.
# For Gmail: smtp.gmail.com, port 587 (STARTTLS), and a 16-character app
# password from https://myaccount.google.com/apppasswords (2FA required).
# MAIL_FROM is optional; without it the From header is SMTP_USER.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-username
SMTP_PASSWORD=your-password-or-app-token
MAIL_FROM="Weekly Synthetic Data <weekly@example.com>"
# Optional; defaults to 60 seconds.
SMTP_TIMEOUT=60

# Used by `send_report.py --test`: a real send that goes only to this address
# and records no history, so it cannot suppress the weekly email.
DRY_RUN_RECIPIENT=you@example.com
