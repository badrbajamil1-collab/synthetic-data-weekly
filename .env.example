# Copy to `.env` and fill in. `.env` is git-ignored. Never commit real credentials.
#
# This file documents the SHAPE of the credential set. Only these keys are read
# from the environment; everything else (model, base_url, batch size, thresholds)
# lives in config.yaml so there is one source of truth and no secrets in Git.

# ---------------------------------------------------------------------------
# Phase 2 & 3 — ranking and summarising. READ by src/synthetic_data/llm.py.
# Either OPENROUTER_API_KEY (used locally in .env) or LLM_API_KEY (used in the
# GitHub Actions workflow) is accepted. Get a key at https://openrouter.ai/keys
# — the free tier needs no payment method.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Phase 5 — email. READ by src/synthetic_data/emailer.py.
# Use a dedicated sender account with an app password, not a personal one.
# For Gmail: smtp.gmail.com, port 587 (STARTTLS), and a 16-character app
# password from https://myaccount.google.com/apppasswords (2FA required).
# MAIL_FROM is optional; without it the From header is SMTP_USER.
# On Gmail/Outlook, MAIL_FROM's address must match SMTP_USER (or be left unset)
# so recipients do not flag mismatched domains as spoofing/spam; emailer.py
# enforces that automatically. For long-term deliverability, use a sending
# service authenticated on your company domain (SPF/DKIM/DMARC).
#
# Empty is a supported state: `send_report.py --dry-run` and the scheduled task
# (which runs dry-run by default) need none of these. Only a real send does.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-username
SMTP_PASSWORD=your-password-or-app-token
MAIL_FROM="Weekly Synthetic Data <your-username@example.com>"
# Optional; directs "Reply with feedback." replies to your preferred inbox.
# REPLY_TO=you@example.com
# Optional; defaults to 60 seconds.
SMTP_TIMEOUT=60

# Used by `send_report.py --test`: a real send that goes only to this address
# and records no history, so it cannot suppress the weekly email.
DRY_RUN_RECIPIENT=you@example.com

# ---------------------------------------------------------------------------
# Optional - GitHub. READ by src/synthetic_data/collectors.py. Raises the
# unauthenticated 60 req/h limit to 5000 req/h. Leave unset for local runs.
# ---------------------------------------------------------------------------
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Optional - Cloudflare web archive publish. READ by publish_to_cloudflare.py.
# Matches the Worker's CRON_RUN_TOKEN secret so GitHub Actions (single producer)
# can sync the verified weekly report + PDF straight into Cloudflare D1 + R2.
# ---------------------------------------------------------------------------
# CF_PUBLISH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CF_WORKER_URL=https://synthetic-data-web.coolbadrtv1.workers.dev
