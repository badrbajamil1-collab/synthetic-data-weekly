# SMTP settings for Phase 5 (email). Copy to `.env` and fill in.
# `.env` is git-ignored. Never commit real credentials.
#
# Nothing reads these yet — no code sends email. The keys are listed so the
# shape of the credential set is decided before the send path is written.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-username
SMTP_PASSWORD=your-password-or-app-token
MAIL_FROM="Weekly Synthetic Data <weekly@example.com>"

# While testing, send only to yourself instead of the five recipients in config.yaml.
DRY_RUN_RECIPIENT=you@example.com
